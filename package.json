{
  "name": "ubereats-order-history-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for your Uber Eats order history: orders, line items, fees, tips and the card behind every charge - straight from Uber Eats' own data feeds, signed in with the session your Chrome already has.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ubereats-order-history-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CREDITS.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "uber-eats",
    "ubereats",
    "order-history",
    "receipts",
    "transactions",
    "expense-tracking",
    "personal-finance",
    "playwright"
  ],
  "author": "Taylor Medford",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmedford/ubereats-order-history-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tmedford/ubereats-order-history-mcp/issues"
  },
  "homepage": "https://github.com/tmedford/ubereats-order-history-mcp#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "node-html-parser": "^9.0.4",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
